# Template for .env - copy, then paste your real keys.
#
#     cp .env.example .env && chmod 600 .env
#
# This file IS committed and must never hold a real key.
# The .env you create from it is gitignored by the repo-root .gitignore.
#
# Rules that bite if you break them:
#   - No space after '='.  KEY= sk-...  fails under `set -a; source .env`.
#   - No quotes needed.    OPENAI_API_KEY=sk-proj-abc  (not "sk-proj-abc")
#   - One KEY=VALUE per line, no trailing spaces.

# --- Provider & model (not secrets) -----------------------------------------
LLM_PROVIDER=groq
OPENAI_MODEL=gpt-4.1-mini
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=models/gemini-embedding-001

# --- API keys ---------------------------------------------------------------
# Only the provider you actually use needs a real value.

# https://platform.openai.com/api-keys   (paid - needs a funded account)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# https://console.groq.com/keys          (free tier)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# https://aistudio.google.com/apikey     (free tier - also used for embeddings)
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# https://console.anthropic.com/settings/keys   (paid)
ANTHROPIC_API_KEY=
