# The repo-root .gitignore already covers .env, myenv/ and __pycache__/.
# This is the local, project-scoped copy.

# Secrets - never commit
.env
.env.local

# Virtual environment
myenv/

# Python bytecode
__pycache__/
*.py[cod]

# Generated FAISS index - rebuilt by "Build Knowledge Base", and only valid
# for the embedding model that produced it (src/vectorstore.py writes here).
data/vectorstore/

# User-uploaded PDFs/DOCX - app.py saves uploads here. Not source.
data/documents/
