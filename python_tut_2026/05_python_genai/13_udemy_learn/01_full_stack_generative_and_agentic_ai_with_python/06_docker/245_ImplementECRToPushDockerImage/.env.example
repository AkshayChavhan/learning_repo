# Copy to .env and fill in. .env is gitignored.
# Your 12-digit account id: AWS console, top-right menu, or `aws sts get-caller-identity`
AWS_ACCOUNT_ID=123456789012
AWS_REGION=ap-south-1          # Mumbai, as in the lecture
ECR_REPO=backend               # the repository you created in the ECR console
IMAGE_TAG=latest
